# Local development only. Generate a new secret and use verified TLS services in production.
NODE_ENV=development
APP_URL=http://localhost:5173
PORT=8000
DATABASE_URL=postgres://development:development-only@localhost:5432/internazionalerossa
AUTH_SECRET=development-only-change-before-any-public-deployment
MAIL_TRANSPORT=none
# Development values only. The self-hosted Gmail setup belongs in the ignored .selfhost/runtime.env; never put an app password here.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=development
SMTP_PASSWORD=development-only
MAIL_FROM=PolisRossa <noreply@example.test>
# Optional SHA-256 of a private sign-up code. It never gates password recovery; keep the plaintext outside Git.
ACCOUNT_ACCESS_HASH=
REGISTRATIONS_OPEN=false
FORUM_OPEN=false

# Optional Cloudflare Worker edge. `selfhost.mjs edge-origin` writes the real
# key only to ignored .selfhost/runtime.env; never commit or paste it here.
EDGE_SHARED_SECRET=
EDGE_PUBLIC_ORIGIN=
EDGE_UPSTREAM_ORIGIN=
EDGE_ORIGIN_ACTIVE=false
LOCAL_HTTPS_PORT=

# Public legal contact. Configure the actual controller before opening the service.
PUBLIC_OPERATOR_NAME=
PUBLIC_PRIVACY_CONTACT=
